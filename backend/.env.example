# 复制为 backend/.env 后，通过 uvicorn backend.app.main:app --env-file backend/.env 加载，
# 或在 API/Worker 的进程环境中设置；修改后需重启相应进程。
# disabled | openai | ollama | vllm | compatible
CODE_EXPLORER_LLM_PROVIDER=disabled

# 启用 Provider 时必填，使用该端点实际提供的模型名称。
CODE_EXPLORER_LLM_MODEL=

# OpenAI 必填；兼容服务按其认证要求填写。实际密钥只能保存在本机配置中。
CODE_EXPLORER_LLM_API_KEY=

# 默认地址：
# openai -> https://api.openai.com/v1
# ollama -> http://localhost:11434/v1
# vllm  -> http://localhost:8001/v1
# compatible 必须显式填写服务地址。
CODE_EXPLORER_LLM_BASE_URL=

# 应用输入预算，不代表模型平台上下文容量；本地请求计数仍需模板安全余量。
# 若已确认部署窗口为 524288，可将应用预算与窗口均设为 524288；
# 实际输入仍扣除输出上限和余量。未知模型保留下面的小预算，不猜测平台容量。
CODE_EXPLORER_LLM_MAX_INPUT_TOKENS=18000
# 未配置输出变量默认 2400；显式留空表示不发送输出上限字段，由平台决定（并非无限输出）。
# 有限值为 128～32768；非法值明确报错，不静默回退或截顶。
CODE_EXPLORER_LLM_MAX_OUTPUT_TOKENS=2400
# 空值模式的本地窗口预留，128～1000000；不发送给平台，也不限制实际输出。
# 这是规划值，不能保证实际输出可容纳；有限模式仍按实际输出上限预留。
CODE_EXPLORER_LLM_OUTPUT_RESERVE_TOKENS=32768
# 连接/响应头及非流式 socket 等待，默认 600 秒，范围 1～3600；不是整个 Agent 时限。
CODE_EXPLORER_LLM_REQUEST_TIMEOUT_SECONDS=600
# Chat Completions 上游 SSE；默认关闭以兼容未经验证的端点，当前 GLM 端点可启用为 1。
# Responses 不使用此开关；不支持时应显式关闭，不会失败后偷偷换协议重发。
CODE_EXPLORER_LLM_CHAT_STREAM=0
# 请求流末尾供应商真实 usage；若端点不支持 stream_options，明确设为 0。
CODE_EXPLORER_LLM_STREAM_INCLUDE_USAGE=1
# 已收到响应头后的流式空闲超时，默认 120 秒，范围 1～3600。
CODE_EXPLORER_LLM_STREAM_IDLE_TIMEOUT_SECONDS=120
# 每次尝试总预算（含响应头等待），默认 1800 秒，范围 1～7200；不跨轮次累计。
# 已建立连接有读取看门狗；DNS/连接等待仍受系统和 socket 超时约束，不是强制进程截止。
# 显式小超时探测同时收紧空闲和总预算；部分流/协议错误不重放，初始临时错误有限退避。
CODE_EXPLORER_LLM_REQUEST_TOTAL_TIMEOUT_SECONDS=1800
# 经当前端点验证后可提高输出。
# 这是单次上限，不保证全部为可见报告文本，也不会每次固定生成到上限。
# 未确认平台窗口时留空，不按模型别名或官方原版容量自动填充。
CODE_EXPLORER_LLM_CONTEXT_WINDOW_TOKENS=
CODE_EXPLORER_LLM_TOKEN_MARGIN=512
# 旧字符保护：0 表示关闭；若旧 .env 仍是 5500，则会继续限制实际请求。
CODE_EXPLORER_LLM_MAX_CONTEXT_CHARS=0
# auto | utf8；两者均采用标准库 UTF-8 字节保守估算，不加载词表。
CODE_EXPLORER_LLM_TOKENIZER=auto
# max_tokens | max_completion_tokens；依据当前兼容平台文档显式配置。
CODE_EXPLORER_LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
# 可选供应商参数；仅在当前端点明确支持时填写，默认不发送。
CODE_EXPLORER_LLM_REASONING_EFFORT=
# 最终报告协议：tools_none 保留定义并禁用工具（原默认）；history_no_tools 不提供定义，保留配对历史。
# 按需分批实验 v20 固定为报告提交工具/无工具汇总的阶段隔离；此配置仅影响其他流程，并在新实验中记录原配置值。
# 应先用 test/probe_final_report_modes.py --send 验证当前端点；失败不会自动切换模式。
# 修改影响新实验条件，API 和 Worker 都需重启，不能与原模式或不同轮次试次混算。
CODE_EXPLORER_LLM_FINAL_REPORT_MODE=tools_none

# API / Agent Worker / Execution Worker 共用的运行日志（不含源码或模型正文）。
CODE_EXPLORER_LOG_LEVEL=INFO
CODE_EXPLORER_LOG_FILE_ENABLED=1
# 留空写入 backend/storage/logs，文件按进程角色与 PID 分离，避免多进程轮转冲突。
CODE_EXPLORER_LOG_DIR=
CODE_EXPLORER_LOG_MAX_BYTES=10485760
CODE_EXPLORER_LOG_BACKUP_COUNT=5

# 语法解析器缓存根；留空使用 backend/storage/runtime 中按版本/平台隔离的目录。
# 安装/迁移时先运行 README 的准备命令，正常分析不允许隐式下载。
CODE_EXPLORER_PARSER_CACHE_DIR=

# Go 类型/SSA 分析：空平台使用安装的 Go 的宿主平台，不按项目名称猜测。
# 如明确按 Linux 服务构建条件分析，设为 linux / amd64；不会执行交叉编译后的程序。
CODE_EXPLORER_GO_TARGET_OS=
CODE_EXPLORER_GO_TARGET_ARCH=
# 可选构建标签，逗号或空格分隔；不接受任意 GOFLAGS、外部编译钩子。
CODE_EXPLORER_GO_BUILD_TAGS=
# 空值优先用工作区已准备的 .goenv；没有本地环境则只读查询 go env 的有效缓存位置。
# 用 backend/tools/go_semantics/prepare.ps1 显式准备依赖，正常分析仍离线；不改全局 Go 配置。
# 显式路径必须为项目根外的绝对路径；分析仍不自动下载依赖、不改目标 go.mod/go.sum。
CODE_EXPLORER_GO_MODULE_CACHE=
CODE_EXPLORER_GO_BUILD_CACHE=
# GOWORK、CGO、认证命令和外部 packages driver 仍禁用，不直接继承用户 Go 构建脚本配置。

# Git 主机白名单，逗号分隔；未设置时默认允许 github.com 和 gitlab.com。
# 自建 GitLab 需显式添加其准确主机名，不使用通配域名。
# 为空时仅允许全部解析地址都属于公网的主机。
GIT_ALLOWED_HOSTS=github.com,gitlab.com

# HTTP 请求体上限；ZIP 解压另有更严格的独立限制。
MAX_HTTP_REQUEST_BYTES=230686720
# 未配置允许的镜像时禁用隔离执行；Worker 需预先拉取镜像，因为运行使用 --pull never。
EXECUTION_ALLOWED_IMAGES=
EXECUTION_SCAN_IMAGE_BANDIT=
EXECUTION_SCAN_IMAGE_SEMGREP=

# 服务端硬限制，客户端只能选择更低的值。
EXECUTION_MAX_TIMEOUT_SECONDS=300
EXECUTION_MAX_CPUS=2
EXECUTION_MAX_MEMORY_MB=2048
EXECUTION_MAX_PIDS=256
EXECUTION_MAX_OUTPUT_BYTES=1048576
EXECUTION_MAX_ACTIVE_TASKS_PER_USER=5

# 仅用于独立执行 Worker。
EXECUTION_DOCKER_BINARY=docker
EXECUTION_WORKER_ID=

# 新实验的脱敏可见请求审计；这是 JSON 负载配额，不是数据库物理文件硬上限。
# 已盲评记录受保护、不自动过期；未盲评且已终止的运行默认保留 30 天。
EXPERIMENT_AUDIT_RECORD_BYTES=4194304
EXPERIMENT_AUDIT_RUN_BYTES=33554432
EXPERIMENT_AUDIT_TOTAL_BYTES=1073741824
EXPERIMENT_AUDIT_RETENTION_DAYS=30
# 正文网页读取默认关闭；显式开启后仍限本机、项目所有者和揭盲条件。
# 请设置独立的至少 32 字符随机 ASCII 管理员口令，不要复用 API Key。
EXPERIMENT_AUDIT_READ_ENABLED=0
EXPERIMENT_AUDIT_READ_TOKEN=

# 只有平台明确保证当前端点的 HTTP 429/503 是执行前拒绝时才填写指纹；默认空，不推定零消耗。
# 使用 llm.settings.endpoint_accounting_fingerprint() 生成；不含密钥。端点/模型切换后自动失效。
# 新实验冻结该声明，保留供应商原始 usage；另列零模型Token假设与剔除拒绝/退避后的耗时。
CODE_EXPLORER_LLM_PRE_MODEL_REJECTION_ENDPOINT_SHA256=
