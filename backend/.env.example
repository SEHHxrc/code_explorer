# Pass this file with `uvicorn backend.app.main:app --env-file backend/.env` after
# copying it to backend/.env, or define the variables in the server environment.
# disabled | openai | ollama | vllm | compatible
CODE_EXPLORER_LLM_PROVIDER=disabled

# Required whenever a provider is enabled. Choose a model actually served by that provider.
CODE_EXPLORER_LLM_MODEL=

# Required for OpenAI; optional for compatible private endpoints.
# Quotes are accepted by dotenv, but an unquoted value avoids shell-specific ambiguity.
CODE_EXPLORER_LLM_API_KEY=

# Defaults:
# openai -> https://api.openai.com/v1
# ollama -> http://localhost:11434/v1
# vllm  -> http://localhost:8001/v1
# Set this explicitly for provider=compatible.
CODE_EXPLORER_LLM_BASE_URL=

# Application-side budgets. The character limit bounds project context before a
# request; it is not the model's own context-window size. Output is sent using
# max_output_tokens (Responses) or max_tokens (Chat Completions compatible APIs).
# Some third-party gateways return 5xx or reset the connection for long prompts;
# lower this value to 4000-8000 for those services.
CODE_EXPLORER_LLM_MAX_CONTEXT_CHARS=18000
CODE_EXPLORER_LLM_MAX_OUTPUT_TOKENS=2400

# Optional comma-separated Git host allowlist. Production deployments should set this.
# When empty, any hostname is accepted only if every resolved address is public.
GIT_ALLOWED_HOSTS=github.com,gitlab.com

# Generic HTTP request ceiling; ZIP extraction applies stricter independent limits.
MAX_HTTP_REQUEST_BYTES=230686720
# Isolated execution is disabled until at least one image/profile is configured.
# Images must be pre-pulled on the Worker host because Docker runs with --pull never.
EXECUTION_ALLOWED_IMAGES=
EXECUTION_SCAN_IMAGE_BANDIT=
EXECUTION_SCAN_IMAGE_SEMGREP=

# Hard server-side limits. Client requests may only choose lower values.
EXECUTION_MAX_TIMEOUT_SECONDS=300
EXECUTION_MAX_CPUS=2
EXECUTION_MAX_MEMORY_MB=2048
EXECUTION_MAX_PIDS=256
EXECUTION_MAX_OUTPUT_BYTES=1048576
EXECUTION_MAX_ACTIVE_TASKS_PER_USER=5

# Used only by the separate Worker process.
EXECUTION_DOCKER_BINARY=docker
EXECUTION_WORKER_ID=
