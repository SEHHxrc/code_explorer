# 复制为 backend/.env 后，通过 uvicorn backend.app.main:app --env-file backend/.env 加载，
# 或在 API/Worker 的进程环境中设置；修改后需重启相应进程。
# disabled | openai | ollama | vllm | compatible
CODE_EXPLORER_LLM_PROVIDER=disabled

# 启用 Provider 时必填，使用该端点实际提供的模型名称。
CODE_EXPLORER_LLM_MODEL=

# OpenAI 必填；兼容服务按其认证要求填写。实际密钥只能保存在本机配置中。
CODE_EXPLORER_LLM_API_KEY=

# 默认地址：
# openai -> https://api.openai.com/v1
# ollama -> http://localhost:11434/v1
# vllm  -> http://localhost:8001/v1
# compatible 必须显式填写服务地址。
CODE_EXPLORER_LLM_BASE_URL=

# 应用输入预算，不代表模型平台上下文容量；本地请求计数仍需模板安全余量。
# 若已确认部署窗口为 524288，可将应用预算与窗口均设为 524288；
# 实际输入仍扣除输出上限和余量。未知模型保留下面的小预算，不猜测平台容量。
CODE_EXPLORER_LLM_MAX_INPUT_TOKENS=18000
CODE_EXPLORER_LLM_MAX_OUTPUT_TOKENS=2400
# 经当前端点验证后可提高输出，当前本机配置采用 8192。
# 这是单次上限，不保证全部为可见报告文本，也不会每次固定生成到上限。
# 未确认平台窗口时留空，不按模型别名或官方原版容量自动填充。
CODE_EXPLORER_LLM_CONTEXT_WINDOW_TOKENS=
CODE_EXPLORER_LLM_TOKEN_MARGIN=512
# 旧字符保护：0 表示关闭；若旧 .env 仍是 5500，则会继续限制实际请求。
CODE_EXPLORER_LLM_MAX_CONTEXT_CHARS=0
# auto | utf8；两者均采用标准库 UTF-8 字节保守估算，不加载词表。
CODE_EXPLORER_LLM_TOKENIZER=auto
# max_tokens | max_completion_tokens；依据当前兼容平台文档显式配置。
CODE_EXPLORER_LLM_OUTPUT_TOKEN_PARAMETER=max_tokens
# 可选供应商参数；仅在当前端点明确支持时填写，默认不发送。
CODE_EXPLORER_LLM_REASONING_EFFORT=

# Git 主机白名单，逗号分隔；生产环境应显式设置。
# 为空时仅允许全部解析地址都属于公网的主机。
GIT_ALLOWED_HOSTS=github.com,gitlab.com

# HTTP 请求体上限；ZIP 解压另有更严格的独立限制。
MAX_HTTP_REQUEST_BYTES=230686720
# 未配置允许的镜像时禁用隔离执行；Worker 需预先拉取镜像，因为运行使用 --pull never。
EXECUTION_ALLOWED_IMAGES=
EXECUTION_SCAN_IMAGE_BANDIT=
EXECUTION_SCAN_IMAGE_SEMGREP=

# 服务端硬限制，客户端只能选择更低的值。
EXECUTION_MAX_TIMEOUT_SECONDS=300
EXECUTION_MAX_CPUS=2
EXECUTION_MAX_MEMORY_MB=2048
EXECUTION_MAX_PIDS=256
EXECUTION_MAX_OUTPUT_BYTES=1048576
EXECUTION_MAX_ACTIVE_TASKS_PER_USER=5

# 仅用于独立执行 Worker。
EXECUTION_DOCKER_BINARY=docker
EXECUTION_WORKER_ID=
